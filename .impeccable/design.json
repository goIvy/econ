  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled main action, e.g. Calculate My Path or Compare Colleges.",
      "html": "<button class=\"ds-btn-primary\">Calculate my path</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border:0;border-radius:var(--radius-sm,10px);background:var(--ink,#10213A);color:var(--on-ink,#fff);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:0.9375rem;font-weight:600;box-shadow:var(--shadow-1,0 1px 2px rgba(16,33,58,.06));cursor:pointer;transition:background-color .15s,transform .3s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:var(--ink-hover,#1B3152);transform:translateY(-1px)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface button with a strong hairline border for the second action.",
      "html": "<button class=\"ds-btn-secondary\">Explore the simulator</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 20px;border:1px solid var(--rule-strong,#C9C2B4);border-radius:var(--radius-sm,10px);background:var(--surface,#fff);color:var(--ink,#10213A);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:0.9375rem;font-weight:600;box-shadow:var(--shadow-1,0 1px 2px rgba(16,33,58,.06));cursor:pointer;transition:border-color .15s,transform .3s cubic-bezier(.16,1,.3,1)}.ds-btn-secondary:hover{border-color:rgba(16,33,58,.4);transform:translateY(-1px)}.ds-btn-secondary:active{transform:scale(.98)}.ds-btn-secondary:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}"
    },
    {
      "name": "Tertiary Link Button",
      "kind": "button",
      "refersTo": "button-tertiary",
      "description": "Ink text action that underlines on hover.",
      "html": "<button class=\"ds-btn-tertiary\">View as table</button>",
      "css": ".ds-btn-tertiary{background:none;border:0;padding:0;border-radius:var(--radius-xs,6px);color:var(--ink,#10213A);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:0.9375rem;font-weight:600;text-underline-offset:4px;text-decoration-color:var(--rule-strong,#C9C2B4);cursor:pointer}.ds-btn-tertiary:hover{text-decoration-line:underline}.ds-btn-tertiary:active{transform:scale(.98)}.ds-btn-tertiary:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}"
    },
    {
      "name": "Segmented Toggle",
      "kind": "input",
      "refersTo": "segmented-selected",
      "description": "Radio-group toggle for Resident / Non-resident and living arrangement; the ink segment slides.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\" aria-label=\"Residency\"><button class=\"ds-seg-item is-active\" role=\"radio\" aria-checked=\"true\"><span>Resident</span><small>$14,312</small></button><button class=\"ds-seg-item\" role=\"radio\" aria-checked=\"false\"><span>Non-resident</span><small>$48,398</small></button></div>",
      "css": ".ds-seg{display:flex;padding:4px;border:1px solid var(--rule,#DDD8CE);border-radius:var(--radius-sm,10px);background:var(--surface-sunk,#F1EEE7);font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);max-width:360px}.ds-seg-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:40px;padding:6px 12px;border:0;border-radius:7px;background:transparent;color:var(--ink-2,#3E4C63);cursor:pointer;transition:background-color .3s,color .15s}.ds-seg-item span{font-size:.875rem;font-weight:600;line-height:1.2}.ds-seg-item small{font-size:.75rem;color:var(--muted,#5B677A);font-variant-numeric:tabular-nums}.ds-seg-item:hover{color:var(--ink,#10213A)}.ds-seg-item.is-active{background:var(--ink,#10213A);color:var(--on-ink,#fff);box-shadow:var(--shadow-1,0 1px 2px rgba(16,33,58,.06))}.ds-seg-item.is-active small{color:rgba(255,255,255,.8)}.ds-seg-item:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}"
    },
    {
      "name": "Graduated Slider",
      "kind": "input",
      "refersTo": "slider-track",
      "description": "Ticked sunk track, trace-ink fill, ink thumb; min and max always visible.",
      "html": "<div class=\"ds-slider\"><div class=\"ds-slider-head\"><label>Aid per year</label><output>$15,000</output></div><div class=\"ds-slider-track\"><span class=\"ds-slider-fill\"></span><span class=\"ds-slider-thumb\" tabindex=\"0\" role=\"slider\" aria-valuenow=\"15000\" aria-label=\"Aid per year\"></span></div><div class=\"ds-slider-ends\"><span>$0</span><span>$40,000</span></div></div>",
      "css": ".ds-slider{display:grid;gap:8px;max-width:360px;font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif)}.ds-slider-head{display:flex;justify-content:space-between;align-items:baseline}.ds-slider-head label{font-size:.8125rem;font-weight:500;color:var(--muted,#5B677A)}.ds-slider-head output{font-size:.875rem;font-weight:600;color:var(--ink,#10213A);font-variant-numeric:tabular-nums}.ds-slider-track{position:relative;height:8px;margin:12px 0;border-radius:999px;background-color:var(--surface-sunk,#F1EEE7);background-image:repeating-linear-gradient(90deg,var(--rule-strong,#C9C2B4) 0 1px,transparent 1px 10%)}.ds-slider-fill{position:absolute;inset:0 62% 0 0;border-radius:999px;background:var(--trace-a,#2456C8)}.ds-slider-thumb{position:absolute;left:38%;top:50%;width:20px;height:20px;margin:-10px 0 0 -10px;border:2px solid var(--on-ink,#fff);border-radius:999px;background:var(--ink,#10213A);box-shadow:var(--shadow-2,0 1px 2px rgba(16,33,58,.05),0 8px 24px -12px rgba(16,33,58,.16));cursor:pointer;transition:transform .15s}.ds-slider-thumb:hover{transform:scale(1.1)}.ds-slider-thumb:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}.ds-slider-ends{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted,#5B677A);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Readout",
      "kind": "custom",
      "refersTo": "readout-value",
      "description": "Caption label, tabular number, muted unit, source footnote marker; counts up on change.",
      "html": "<dl class=\"ds-readout\"><dt>Net cost, 4 years</dt><dd><span class=\"ds-readout-n\">$78,400</span><span class=\"ds-readout-u\">total</span><button class=\"ds-fn\" aria-label=\"View source for Net cost\">1</button></dd><dd class=\"ds-readout-est\">Estimate</dd></dl>",
      "css": ".ds-readout{display:grid;gap:4px;margin:0;font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif)}.ds-readout dt{font-size:.8125rem;font-weight:500;color:var(--muted,#5B677A)}.ds-readout dd{margin:0;display:flex;align-items:baseline;gap:6px}.ds-readout-n{font-size:1.5rem;line-height:1.1;letter-spacing:-.01em;font-weight:600;color:var(--ink,#10213A);font-variant-numeric:tabular-nums}.ds-readout-u{font-size:.8125rem;font-weight:500;color:var(--muted,#5B677A)}.ds-readout-est{font-size:.75rem;font-weight:500;color:var(--muted,#5B677A)}.ds-fn{display:inline-flex;align-items:center;justify-content:center;height:1.15rem;min-width:1.15rem;padding:0 4px;transform:translateY(-.35em);border:1px solid var(--rule-strong,#C9C2B4);border-radius:4px;background:var(--surface,#fff);color:var(--ink-2,#3E4C63);font-size:.625rem;font-weight:600;line-height:1;cursor:pointer;transition:border-color .15s,color .15s}.ds-fn:hover{border-color:var(--ink,#10213A);color:var(--ink,#10213A)}.ds-fn:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}"
    },
    {
      "name": "Path Tag",
      "kind": "chip",
      "refersTo": "path-tag",
      "description": "Letter A-E on its trace ink, followed by the path's specimen line.",
      "html": "<span class=\"ds-path\"><span class=\"ds-path-tag\" style=\"background:var(--trace-a,#2456C8)\">A</span><span>UC Berkeley · Economics · CA resident</span></span> <span class=\"ds-path\"><span class=\"ds-path-tag\" style=\"background:var(--trace-b,#007F68)\">B</span><span>UT Austin · Economics · Non-resident</span></span>",
      "css": ".ds-path{display:inline-flex;align-items:center;gap:8px;margin:4px 12px 4px 0;font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:.875rem;color:var(--ink,#10213A)}.ds-path-tag{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:var(--radius-xs,6px);color:var(--on-ink,#fff);font-size:.8125rem;font-weight:700;line-height:1}"
    },
    {
      "name": "Confidence Badge and Sample Chip",
      "kind": "chip",
      "refersTo": "badge-confidence-high",
      "description": "Three-bar gauge plus words; never color alone.",
      "html": "<span class=\"ds-badge ds-badge-high\"><span class=\"ds-gauge\"><i style=\"height:5px\"></i><i style=\"height:7.5px\"></i><i style=\"height:10px\"></i></span>High confidence</span> <span class=\"ds-badge ds-badge-mod\"><span class=\"ds-gauge\"><i style=\"height:5px\"></i><i style=\"height:7.5px\"></i><i class=\"off\" style=\"height:10px\"></i></span>Moderate confidence</span> <span class=\"ds-badge ds-badge-mod\"><span class=\"ds-dot\"></span>Sample data</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;margin:2px;padding:2px 8px;border-radius:999px;font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);font-size:.75rem;font-weight:600}.ds-badge-high{background:var(--gain-tint,#E4F0E8);color:var(--gain,#2A7547)}.ds-badge-mod{background:var(--caution-tint,#F6ECD6);color:var(--caution,#8A5A0B)}.ds-gauge{display:flex;align-items:flex-end;gap:2px}.ds-gauge i{display:block;width:3px;border-radius:1px;background:currentColor}.ds-gauge i.off{opacity:.25}.ds-dot{width:6px;height:6px;border-radius:999px;background:currentColor}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Surface, 1px hairline, 14px radius, resting shadow; interactive cards shift border and shadow, not position.",
      "html": "<a class=\"ds-card\" href=\"#\"><strong>University of Michigan</strong><span>Ann Arbor, MI · Public</span></a>",
      "css": ".ds-card{display:grid;gap:4px;max-width:320px;padding:16px 20px;border:1px solid var(--rule,#DDD8CE);border-radius:var(--radius-md,14px);background:var(--surface,#fff);box-shadow:var(--shadow-1,0 1px 2px rgba(16,33,58,.06));color:var(--ink,#10213A);text-decoration:none;font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif);transition:border-color .2s,box-shadow .2s}.ds-card strong{font-family:var(--font-display,'Schibsted Grotesk',ui-sans-serif,system-ui,sans-serif);font-size:1.2rem;font-weight:600;letter-spacing:-.01em}.ds-card span{font-size:.875rem;color:var(--muted,#5B677A)}.ds-card:hover{border-color:var(--rule-strong,#C9C2B4);box-shadow:var(--shadow-2,0 1px 2px rgba(16,33,58,.05),0 8px 24px -12px rgba(16,33,58,.16))}.ds-card:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav",
      "description": "64px sticky paper header; ink underline marks the active link.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-nav-logo\">College Value Lab</span><nav><a href=\"#\">Explore</a><a href=\"#\" aria-current=\"page\">Compare</a><a href=\"#\">Simulator</a><a href=\"#\">Methodology</a></nav><a class=\"ds-nav-cta\" href=\"#\">Get started</a></header>",
      "css": ".ds-nav{display:flex;align-items:center;gap:24px;height:64px;padding:0 32px;background:rgba(248,246,242,.92);border-bottom:1px solid var(--rule,#DDD8CE);box-shadow:var(--shadow-1,0 1px 2px rgba(16,33,58,.06));font-family:var(--font-sans,Geist,ui-sans-serif,system-ui,sans-serif)}.ds-nav-logo{font-family:var(--font-display,'Schibsted Grotesk',ui-sans-serif,system-ui,sans-serif);font-weight:700;color:var(--ink,#10213A)}.ds-nav nav{display:flex;gap:4px;flex:1}.ds-nav nav a{position:relative;padding:6px 10px;border-radius:var(--radius-xs,6px);font-size:.875rem;font-weight:500;color:var(--ink-2,#3E4C63);text-decoration:none;transition:color .15s}.ds-nav nav a:hover,.ds-nav nav a[aria-current=page]{color:var(--ink,#10213A)}.ds-nav nav a[aria-current=page]::after{content:'';position:absolute;left:10px;right:10px;bottom:-13px;height:2px;border-radius:999px;background:var(--ink,#10213A)}.ds-nav a:focus-visible{outline:2px solid var(--trace-a);outline-offset:2px}.ds-nav-cta{display:inline-flex;align-items:center;height:36px;padding:0 12px;border-radius:var(--radius-sm,10px);background:var(--ink,#10213A);color:var(--on-ink,#fff);font-size:.875rem;font-weight:600;text-decoration:none}.ds-nav-cta:hover{background:var(--ink-hover,#1B3152)}"
    },
    {
      "name": "Axis Rule",
      "kind": "custom",
      "refersTo": "",
      "description": "Section divider: a hairline carrying ticks every 8px and major ticks every 40px.",
      "html": "<div class=\"ds-axis\" aria-hidden=\"true\"></div>",
      "css": ".ds-axis{height:9px;width:100%;background-image:linear-gradient(var(--rule-strong,#C9C2B4),var(--rule-strong,#C9C2B4)),repeating-linear-gradient(90deg,var(--rule-strong,#C9C2B4) 0 1px,transparent 1px 40px),repeating-linear-gradient(90deg,var(--rule,#DDD8CE) 0 1px,transparent 1px 8px);background-size:100% 1px,100% 9px,100% 5px;background-repeat:no-repeat}"
    }
  ],
  "narrative": {
    "northStar": "The Calibrated Instrument",
    "overview": "Each college path is an experiment the visitor runs on a precision instrument. The page is not a brochure that ranks schools: it is a warm off-white bench ruled by a faint measured grid, with navy ink for structure and a small set of \"trace inks\" that identify each path (A through E) the way a plotter identifies its pens. Numbers are read off the instrument as readouts, in tabular Geist numerals with muted units and a footnote marker that answers \"where did this come from?\"\n\nThe density is that of a lab instrument, not a dashboard: a few large, rounded panels hold the controls, readouts and chart for one experiment, and everything around them stays quiet. Headlines in Schibsted Grotesk are confident, tightly set and undecorated. Motion is calibrated rather than decorative: readouts count up from their previous value, traces draw once and then morph, and the break-even marker settles in last.\n\nThe build is light-first and explicitly rejects the fintech default (dark gold and purple, headline plus dashboard screenshot plus three feature cards), gradient text, glassmorphism, and any single \"score\" or verdict for a college.",
    "keyCharacteristics": [
      "Warm paper field (#F8F6F2) with an 8px/40px measured grid behind instruments only.",
      "Navy ink (#10213A) for text, axes and primary fills; blue and teal trace inks for Path A and Path B.",
      "Every path encoded three ways: letter tag, trace color, and line style.",
      "Readouts: caption label, tabular number, muted unit, source footnote marker.",
      "Tick-marked axis rules divide sections.",
      "Radius encodes hierarchy: instrument (20px) > card (14px) > control (10px) > tag (6px).",
      "Soft navy-tinted shadows; no grey shadows, no glows."
    ],
    "rules": [
      {
        "name": "The Three Encodings Rule",
        "body": "A path is never identified by color alone. It always carries its letter tag, its trace color and its line style (solid, solid, dashed, dotted, dash-dot), plus a direct end label in charts. Series text is set in ink, never in trace color.",
        "section": "colors"
      },
      {
        "name": "The Signals Are Readouts Rule",
        "body": "Gain, caution and risk appear only in readout states, badges and chips, always paired with a word or icon (\"High confidence\", \"Sample data\"). They never decorate layout.",
        "section": "colors"
      },
      {
        "name": "The Three Gradients Rule",
        "body": "Gradients appear in exactly three places: the hero field wash (two radial washes of trace A at 8% and trace B at 7%), chart emphasis under a trace, and the closing CTA band. Nothing else.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "Sentence case everywhere. No all-caps labels, no tracked-out eyebrows, and no headline with a single word set in another color or in italic.",
        "section": "typography"
      },
      {
        "name": "The Muted Unit Rule",
        "body": "A unit sits beside its number in `--muted`, smaller and lighter (for example \"$78,400 /yr\"), and the number is always tabular.",
        "section": "typography"
      },
      {
        "name": "The Earned Shadow Rule",
        "body": "Shadow grows only on interaction or for the single most important object in a view. Shadows are always navy-tinted, never grey, and never glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take every color, font, radius and shadow from the tokens in `app/globals.css`, which mirror `design-system/MASTER.md`.",
      "Do give every number units, tabular numerals and a source footnote marker; label projections \"Estimate\" and seeded values \"Sample data\".",
      "Do identify each path with its letter tag, trace ink and line style together.",
      "Do keep text contrast at 4.5:1 or higher and use the 2px `--trace-a` focus ring at 2px offset.",
      "Do divide quantitative sections with the tick-marked axis rule, and put the measured grid only behind instruments.",
      "Do step radius down as you nest: 20px instrument, 14px card, 10px control, 6px tag.",
      "Do give every chart a visible text summary, a \"View as table\" fallback and keyboard access.",
      "Do import motion from `lib/animations.ts` and respect reduced motion."
    ],
    "donts": [
      "Don't use gradient text, glassmorphism or backdrop blur on content, purple or pink gradients, or neon glows.",
      "Don't use Inter, Roboto, Arial, IBM Plex, DM Sans, Space Grotesk or Plus Jakarta Sans.",
      "Don't use all-caps labels, tracked-out eyebrows, or a single accented word in a headline.",
      "Don't build identical card grids, put side-stripe borders on cards, or use one radius everywhere.",
      "Don't reduce a college to a single score or a \"better/worse\" verdict.",
      "Don't convey meaning with color alone, or set series text in trace color.",
      "Don't append arrows to button labels or use emoji as icons (use Lucide).",
      "Don't run infinite decorative loops; shimmer is only for loading."
    ]
  }
}